# Supabase (https://supabase.com -> Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (Claude) para la carga inteligente de archivos. Solo servidor.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-sonnet-5)
ANTHROPIC_MODEL=

# Si no hay Supabase configurado la app funciona en modo local (.data/db.json).
# Solo modo local en produccion: contrasena unica del equipo.
ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE
